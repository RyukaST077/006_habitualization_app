# Production environment template (dummy values only)
APP_ENV=prod
SUPABASE_ENV=prod
APP_ORIGIN=https://app.example.com

# Public client settings
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=prod-anon-key-placeholder

# Server/test compatibility settings
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=prod-anon-key-placeholder

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=prod-service-role-key-placeholder
DATABASE_URL=postgresql://prod_user:prod_password@prod-db.internal:5432/prod_db

# Safety guard
PREVIEW_FORBID_PROD_CONNECTION=true
