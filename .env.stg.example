# Staging environment template (dummy values only)
APP_ENV=stg
SUPABASE_ENV=stg
APP_ORIGIN=https://stg.example.com

# Public client settings
NEXT_PUBLIC_SUPABASE_URL=https://stg-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=stg-anon-key-placeholder

# Server/test compatibility settings
SUPABASE_URL=https://stg-project-ref.supabase.co
SUPABASE_ANON_KEY=stg-anon-key-placeholder

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=stg-service-role-key-placeholder
DATABASE_URL=postgresql://stg_user:stg_password@stg-db.internal:5432/stg_db

# Safety guard
PREVIEW_FORBID_PROD_CONNECTION=true
