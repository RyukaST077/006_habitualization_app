{
  "name": "habitualization_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "sh -c 'if docker info >/dev/null 2>&1; then supabase status; else echo \"Docker daemon is not running; skipped supabase status.\"; fi'",
    "db:seed": "sh -c 'if docker info >/dev/null 2>&1; then supabase seed --local; else echo \"Docker daemon is not running; skipped supabase seed.\"; fi'",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:smoke": "E2E_SMOKE_GUARD=1 playwright test tests/e2e/smoke --pass-with-no-tests",
    "test:e2e:smoke:list": "E2E_SMOKE_GUARD=1 playwright test tests/e2e/smoke --pass-with-no-tests --list",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "supabase": "^2.76.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^3.0.8"
  }
}
