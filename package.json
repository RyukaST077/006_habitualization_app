{
  "name": "habitualization_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:smoke": "E2E_SMOKE_GUARD=1 playwright test tests/e2e/smoke --pass-with-no-tests",
    "test:e2e:smoke:list": "E2E_SMOKE_GUARD=1 playwright test tests/e2e/smoke --pass-with-no-tests --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
