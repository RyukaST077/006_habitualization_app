# Common required keys for all environments
# Set real values in local/secret managers. Do not commit secrets.
SUPABASE_ENV=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=

# E2E fixed-fixture emails (dummy values only; overwrite in CI secrets for stg runs)
E2E_USER_A_EMAIL=user-a-smoke@example.invalid
E2E_USER_B_EMAIL=user-b-smoke@example.invalid
E2E_OPS_1_EMAIL=ops-1-smoke@example.invalid

# Optional for local DB seed verification (psql etc.)
# Example: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_LOCAL_URL=
