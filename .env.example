# Development environment template (dummy values only)
APP_ENV=dev
SUPABASE_ENV=dev

# Public client settings
NEXT_PUBLIC_SUPABASE_URL=https://dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-anon-key-placeholder

# Server-only settings
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key-placeholder
